# Server-only. Never commit a real key.
ANTHROPIC_API_KEY=
# Model used for interrogations (default: claude-sonnet-5-5)
CLAUDE_MODEL=claude-sonnet-5-5
# Set to 1 for scripted offline replies (tests, offline play)
MOCK_AI=0
# Delay per streamed word in mock mode, ms
MOCK_DELAY=25
PORT=8787
# Case Forge (optional): set to 1 to enable npm run forge
FORGE_ENABLED=0
FORGE_MODEL=claude-opus-5-5
