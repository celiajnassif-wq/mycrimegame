{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dossiers/secret.schema.json",
  "title": "Dossiers server-only truth",
  "type": "object",
  "required": [
    "culprit",
    "method",
    "motive",
    "answers",
    "proofDocuments",
    "trueTimeline",
    "documentRoles",
    "eliminations",
    "suspects",
    "epilogue",
    "solutionMemo"
  ],
  "additionalProperties": false,
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "culprit": {
      "$ref": "#/definitions/id"
    },
    "method": {
      "type": "string"
    },
    "motive": {
      "type": "string"
    },
    "answers": {
      "type": "object",
      "required": [
        "how",
        "why"
      ],
      "additionalProperties": false,
      "properties": {
        "how": {
          "$ref": "#/definitions/id"
        },
        "why": {
          "$ref": "#/definitions/id"
        }
      }
    },
    "proofDocuments": {
      "allOf": [
        {
          "$ref": "#/definitions/ids"
        },
        {
          "minItems": 3
        }
      ]
    },
    "trueTimeline": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "time",
          "event"
        ],
        "additionalProperties": false,
        "properties": {
          "time": {
            "type": "string",
            "pattern": "^[0-2][0-9]:[0-5][0-9]$"
          },
          "event": {
            "type": "string"
          }
        }
      }
    },
    "documentRoles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "role",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "proof",
              "elimination",
              "red-herring",
              "context"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "eliminations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "documents",
          "refusal"
        ],
        "additionalProperties": false,
        "properties": {
          "documents": {
            "allOf": [
              {
                "$ref": "#/definitions/ids"
              },
              {
                "minItems": 1
              }
            ]
          },
          "refusal": {
            "type": "string"
          }
        }
      }
    },
    "suspects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "persona",
          "knows",
          "doesNotKnow",
          "hides",
          "lies",
          "mock"
        ],
        "additionalProperties": false,
        "properties": {
          "persona": {
            "type": "object",
            "required": [
              "voice",
              "personality",
              "vocabulary",
              "tics",
              "languageMix"
            ],
            "additionalProperties": false,
            "properties": {
              "voice": {
                "type": "string"
              },
              "personality": {
                "type": "string"
              },
              "vocabulary": {
                "type": "string"
              },
              "tics": {
                "$ref": "#/definitions/strings"
              },
              "languageMix": {
                "type": "string"
              }
            }
          },
          "knows": {
            "$ref": "#/definitions/strings"
          },
          "doesNotKnow": {
            "$ref": "#/definitions/strings"
          },
          "hides": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "what",
                "why"
              ],
              "additionalProperties": false,
              "properties": {
                "what": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                }
              }
            }
          },
          "lies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "claim",
                "truth",
                "caughtBy",
                "pointed",
                "reaction",
                "card"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "#/definitions/id"
                },
                "claim": {
                  "type": "string"
                },
                "truth": {
                  "type": "string"
                },
                "caughtBy": {
                  "allOf": [
                    {
                      "$ref": "#/definitions/ids"
                    },
                    {
                      "minItems": 1
                    }
                  ]
                },
                "pointed": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/strings"
                  }
                },
                "reaction": {
                  "type": "string"
                },
                "card": {
                  "type": "string"
                },
                "spoken": {
                  "type": "string",
                  "description": "Optional first-person line used by mock mode and as a voice example for the model"
                },
                "topic": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Questions on this topic make the suspect commit to the lie (Strategic Use of Evidence)"
                }
              }
            }
          },
          "innocentExplanation": {
            "type": "string"
          },
          "breakdown": {
            "type": "object",
            "required": [
              "minLiesCaught",
              "requiredShown"
            ],
            "additionalProperties": false,
            "properties": {
              "minLiesCaught": {
                "type": "integer",
                "minimum": 1
              },
              "requiredShown": {
                "allOf": [
                  {
                    "$ref": "#/definitions/ids"
                  },
                  {
                    "minItems": 1
                  }
                ]
              }
            }
          },
          "confession": {
            "type": "string"
          },
          "mock": {
            "type": "object",
            "required": [
              "topics",
              "fallback",
              "mood"
            ],
            "additionalProperties": false,
            "properties": {
              "mood": {
                "type": "string"
              },
              "fallback": {
                "allOf": [
                  {
                    "$ref": "#/definitions/strings"
                  },
                  {
                    "minItems": 1
                  }
                ]
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "keywords",
                    "reply"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "keywords": {
                      "$ref": "#/definitions/strings"
                    },
                    "reply": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "falseAdmission": {
            "type": "string",
            "description": "Innocent suspects only: what they say when pressured into an unreliable admission"
          },
          "shutdown": {
            "type": "string",
            "description": "What they say when the investigator turns coercive"
          }
        }
      }
    },
    "epilogue": {
      "$ref": "#/definitions/strings"
    },
    "solutionMemo": {
      "$ref": "#/definitions/strings"
    }
  }
}
